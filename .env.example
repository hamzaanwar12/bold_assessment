# Owner connection: runs migrations and the seed script.
# RLS does NOT apply to a table's owner -- never point the API at this.
DATABASE_URL_OWNER=postgresql+psycopg://techforce:techforce@localhost:5433/techforce

# Application connection: non-owner role, subject to the RLS policy.
# This is the only connection the API may use. See docs/adr/0002.
DATABASE_URL_APP=postgresql+psycopg://techforce_app:techforce_app@localhost:5433/techforce

# Same split for the test database.
TEST_DATABASE_URL_OWNER=postgresql+psycopg://techforce:techforce@localhost:5433/techforce_test
TEST_DATABASE_URL_APP=postgresql+psycopg://techforce_app:techforce_app@localhost:5433/techforce_test

# Password for the non-owner application role created by the migration.
# Required: the migration fails loudly rather than falling back to a literal.
TECHFORCE_APP_PASSWORD=techforce_app
