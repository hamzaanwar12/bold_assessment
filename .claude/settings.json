{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree*)",
      "Bash(git merge*)",
      "Bash(git rebase --continue*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git remote*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(git config user.*)",
      "Bash(gh pr*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(gh api repos/*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(uv*)",
      "Bash(alembic*)",
      "Bash(uvicorn*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(node*)",
      "Bash(docker compose*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(psql*)",
      "Bash(curl -s localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(jq*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(sed -n*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove --force*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge*)",
      "Bash(rm -rf*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)"
    ]
  },
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": ["node_modules", ".venv"]
  }
}
